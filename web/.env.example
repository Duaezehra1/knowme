# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Localhost: any UUID, registered under App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
# Deployed site: a reCAPTCHA Enterprise site key registered in App Check.
VITE_RECAPTCHA_SITE_KEY=
# Optional, Chrome extension only: a registered App Check debug token baked into
# `npm run build:extension` (reCAPTCHA can't run in extension pages). Without it the
# extension uses on-device AI only. Anyone with the built extension can read it: revoke it after testing.
EXTENSION_APPCHECK_TOKEN=
